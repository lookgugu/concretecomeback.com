---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
---
<BaseLayout
  title="Submission Not Received | Concrete Comeback"
  description="Your listing submission was not received. Try again or return to the Concrete Comeback directory."
  noIndex={true}
>
  <div class="max-w-2xl mx-auto px-4 sm:px-6 pb-16">
    <Breadcrumb crumbs={[{ label: 'Submit a Listing', href: '/submit/' }, { label: 'Submission Error', href: '/submit/error/' }]} />

    <div class="text-center py-12">
      <div class="text-5xl mb-6" aria-hidden="true">🛹</div>
      <h1 class="text-3xl sm:text-4xl font-display text-concrete-900 mb-4">
        Sorry — your submission didn’t go through.
      </h1>
      <p class="text-concrete-500 max-w-md mx-auto">
        We didn’t receive your listing. Please try again, or email it to
        <a class="text-skate-orange underline" href="mailto:hello@concretecomeback.com">hello@concretecomeback.com</a>.
      </p>

      <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/submit/" class="px-6 py-3 bg-skate-orange text-white font-bold font-display rounded-lg hover:opacity-90 transition-opacity no-underline">
          Try Again
        </a>
        <a href="/" class="px-6 py-3 border border-concrete-300 text-concrete-600 font-medium rounded-lg hover:border-skate-orange transition-colors no-underline">
          Return Home
        </a>
        <a href="/directory/" class="px-6 py-3 border border-concrete-300 text-concrete-600 font-medium rounded-lg hover:border-skate-orange transition-colors no-underline">
          Browse the Directory
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
