---
import BaseLayout from '@layouts/BaseLayout.astro';
---
<BaseLayout title="Subscription confirmed | Concrete Comeback" description="Your Concrete Comeback subscription is confirmed." noIndex={true}>
  <section class="max-w-2xl mx-auto px-4 sm:px-6 py-16 text-center">
    <h1 class="font-display text-4xl text-concrete-900 mb-4">Your comeback roundup is confirmed</h1>
    <p class="text-lg text-concrete-600 mb-8">You’re in. Watch your inbox for the weekly roundup: the week's best new reads and, when available, one practical idea for your weekend session.</p>
    <a href="/directory/parks" class="inline-block px-6 py-3 bg-skate-orange text-concrete-900 font-bold rounded-lg no-underline">Find a place to skate</a>
  </section>
  <script is:inline>
    try { localStorage.setItem('cc-newsletter-status', 'subscribed'); } catch (error) {}
  </script>
</BaseLayout>
