---
import BaseLayout from '@layouts/BaseLayout.astro';
---
<BaseLayout title="Subscription link problem | Concrete Comeback" description="We could not confirm your Concrete Comeback subscription." noIndex={true}>
  <section class="max-w-2xl mx-auto px-4 sm:px-6 py-16 text-center">
    <p class="text-skate-orange font-bold uppercase tracking-widest mb-3">That link didn’t land</p>
    <h1 class="font-display text-4xl text-concrete-900 mb-4">Request a fresh confirmation</h1>
    <p class="text-lg text-concrete-600 mb-8">Confirmation links only work for two hours. Head back to the site and the signup prompt will offer you a fresh one.</p>
    <a href="/" class="inline-block px-6 py-3 bg-skate-orange text-white font-bold rounded-lg no-underline">Return home</a>
  </section>
  <script is:inline>
    // The prompt suppresses itself after a signup or a dismissal, which would make
    // the instruction above impossible to follow. Clear that state — but keep a
    // confirmed subscriber's status — and count this as a page view so the prompt
    // returns promptly instead of after its first-visit delay (see newsletter-signup.js).
    try {
      if (localStorage.getItem('cc-newsletter-status') === 'pending') localStorage.removeItem('cc-newsletter-status');
      localStorage.removeItem('cc-newsletter-pending-at');
      localStorage.removeItem('cc-newsletter-dismissed-at');
      sessionStorage.setItem('cc-page-views', '1');
    } catch (error) {}
  </script>
</BaseLayout>
