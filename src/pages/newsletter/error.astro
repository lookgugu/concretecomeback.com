---
import BaseLayout from '@layouts/BaseLayout.astro';
import NewsletterInline from '@components/marketing/NewsletterInline.astro';
---
<BaseLayout title="Subscription link problem | Concrete Comeback" description="We could not confirm your Concrete Comeback subscription." noIndex={true}>
  <section class="max-w-2xl mx-auto px-4 sm:px-6 py-16 text-center">
    <p class="text-skate-orange font-bold uppercase tracking-widest mb-3">That link didn’t land</p>
    <h1 class="font-display text-4xl text-concrete-900 mb-4">Request a fresh confirmation</h1>
    <p class="text-lg text-concrete-600 mb-8">
      Confirmation links only work for two hours, and a signup can fail on our side too.
      Either way, ask for a fresh link below.
    </p>
  </section>

  <div class="max-w-2xl mx-auto px-4 sm:px-6 pb-16">
    <!-- Server-rendered, so it is a real retry path for a visitor who got here
         from a failed signup with JavaScript off — the popup cannot be one. -->
    <NewsletterInline
      eyebrow="In preparation"
      heading="Hear when we launch"
      description="We're preparing the planned weekly roundup of the week's best new reads and, when available, one practical idea for your weekend session. Delivery hasn't started; no first-send date is set."
      buttonLabel="Keep me posted"
      consentCopy="By signing up, you agree to receive a launch update and the planned weekly Concrete Comeback email. Confirm your email to opt in. Unsubscribe anytime."
      subscribedMessage="You’re signed up. We’ll let you know when the newsletter launches."
    />
    <p class="mt-8 text-center">
      <a href="/" class="text-sm text-concrete-500 hover:text-concrete-800">← Return home</a>
    </p>
  </div>
  <script is:inline>
    // The prompt suppresses itself after a signup or a dismissal, which would make
    // the instruction above impossible to follow. Clear that state — but keep a
    // confirmed subscriber's status (see newsletter-signup.js).
    try {
      if (localStorage.getItem('cc-newsletter-status') === 'pending') localStorage.removeItem('cc-newsletter-status');
      localStorage.removeItem('cc-newsletter-pending-at');
      localStorage.removeItem('cc-newsletter-dismissed-at');
    } catch (error) {}
  </script>
</BaseLayout>
