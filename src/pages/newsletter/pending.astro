---
import BaseLayout from '@layouts/BaseLayout.astro';
---
<BaseLayout title="Confirm your subscription | Concrete Comeback" description="Check your inbox to confirm your Concrete Comeback subscription." noIndex={true}>
  <section class="max-w-2xl mx-auto px-4 sm:px-6 py-16 text-center">
    <p class="text-skate-orange font-bold uppercase tracking-widest mb-3">One more step</p>
    <h1 class="font-display text-4xl text-concrete-900 mb-4">Check your inbox</h1>
    <p class="text-lg text-concrete-600 mb-8">
      We've sent you a confirmation link. Click it within the next two hours and you're on the roundup.
      If it hasn't arrived in a few minutes, check your spam folder or sign up again to get a fresh link.
    </p>
    <a href="/blog" class="inline-block px-6 py-3 bg-skate-orange text-white font-bold rounded-lg no-underline">Read something while you wait</a>
  </section>
  <script is:inline>
    // Mirrors what the fetch path records, so the signup CTAs stand down for a
    // visitor who got here by submitting the form without JavaScript.
    try {
      localStorage.setItem('cc-newsletter-status', 'pending');
      localStorage.setItem('cc-newsletter-pending-at', String(Date.now()));
    } catch (error) {}
  </script>
</BaseLayout>
