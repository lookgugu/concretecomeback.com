---
// The server-rendered newsletter CTA. BlogLayout renders it at the end of every
// post, so nothing has to be written into the Markdown; the homepage and the
// directory detail pages place it too. It shares the submit path with the popup
// (NewsletterSignup.astro) but none of its triggers: this one is always
// visible and is never dismissed.
//
// `source` is the placement's `newsletter_source` in analytics, and it keys the
// element ids so no two CTAs on a page share one. `in_post` keeps the original
// `newsletter-inline-*` ids; `retry` is /newsletter/error/, where a failed or
// expired signup is retried. `scripts/check-newsletter-placement.mjs` enforces
// which pages carry which source after every build.
interface Props {
  source?: 'in_post' | 'home' | 'directory' | 'retry';
  // Replaces the default end-of-article spacing and rule.
  class?: string;
}

const { source = 'in_post', class: className = 'mt-10 pt-8 border-t border-concrete-200' } = Astro.props;
const prefix = source === 'in_post' ? 'newsletter-inline' : `newsletter-${source}`;
---

<aside
  class:list={['newsletter-inline', className]}
  aria-labelledby={`${prefix}-title`}
  data-newsletter-source={source}
>
  <p class="text-xs font-bold uppercase tracking-widest text-skate-orange mb-2">Monthly roundup</p>
  <h2 id={`${prefix}-title`} class="font-display text-2xl text-concrete-900 mb-2">Keep your comeback rolling</h2>
  <p class="text-sm text-concrete-600 mb-4">
    Get new skate spots and groups, one practical guide, and one community story each month.
  </p>
  <form action="/api/forms/newsletter" method="post" class="space-y-3">
    <div class="sr-only" aria-hidden="true">
      <label for={`${prefix}-company`}>Company</label>
      <input id={`${prefix}-company`} name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <input type="hidden" name="consent" value="yes" />
    <label for={`${prefix}-email`} class="sr-only">Email address</label>
    <div class="flex flex-col sm:flex-row gap-2">
      <input
        id={`${prefix}-email`}
        name="email"
        type="email"
        required
        autocomplete="email"
        placeholder="Email address"
        class="min-w-0 flex-1 rounded-lg border-concrete-300 focus:border-skate-orange focus:ring-skate-orange"
      />
      <button type="submit" class="min-h-11 px-4 py-2 rounded-lg bg-skate-orange text-white font-bold border-0 cursor-pointer disabled:opacity-60">
        Send me the roundup
      </button>
    </div>
    <p class="text-xs text-concrete-500">
      By subscribing, you agree to receive the monthly Concrete Comeback email. Unsubscribe anytime.
      <a href="/privacy" class="underline min-h-0 min-w-0">Privacy</a>
    </p>
  </form>
  <p data-newsletter-status role="status" aria-live="polite" class="text-sm font-medium text-concrete-700 mt-3"></p>
</aside>

<script>
  import { initInlineNewsletterSignup } from '../../scripts/newsletter-signup.js';
  document.querySelectorAll<HTMLElement>('.newsletter-inline').forEach(initInlineNewsletterSignup);
</script>
