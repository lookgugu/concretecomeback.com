---
// Server-rendered signup CTA. BlogLayout renders the full end-of-post version,
// so every blog post gets one automatically — nothing has to be written into the
// Markdown. The homepage and the park directory render the compact version near
// the top of the page. All of them share the submit path with the popup
// (NewsletterSignup.astro) but none of its triggers: they are always visible
// and never dismissed.
//
// `source` is the `newsletter_source` analytics value and also namespaces the
// element ids, so two placements can never collide on one page. Add a new value
// to INLINE_SOURCES in src/scripts/newsletter-signup.js too, or it is reported
// as in_post.
interface Props {
  source?: 'in_post' | 'home_inline' | 'parks_inline';
  compact?: boolean;
}

const { source = 'in_post', compact = false } = Astro.props;
// in_post keeps its original ids so existing anchors and tests stay valid.
const idPrefix = source === 'in_post' ? 'newsletter-inline' : `newsletter-${source.replace('_', '-')}`;
---

<aside
  class:list={[
    'newsletter-inline',
    compact
      ? 'rounded-xl border border-concrete-200 bg-white p-4 sm:p-5'
      : 'mt-10 pt-8 border-t border-concrete-200',
  ]}
  aria-labelledby={`${idPrefix}-title`}
  data-newsletter-source={source}
>
  <p class:list={['text-xs font-bold uppercase tracking-widest text-skate-orange', compact ? 'mb-1' : 'mb-2']}>Weekly roundup</p>
  <h2 id={`${idPrefix}-title`} class:list={['font-display text-concrete-900', compact ? 'text-xl mb-1' : 'text-2xl mb-2']}>Keep your comeback rolling</h2>
  <p class:list={['text-sm text-concrete-600', compact ? 'mb-3' : 'mb-4']}>
    The week's best new reads and one practical idea for your weekend session.
  </p>
  <form action="/api/forms/newsletter" method="post" class:list={[compact ? 'space-y-2' : 'space-y-3']}>
    <div class="sr-only" aria-hidden="true">
      <label for={`${idPrefix}-company`}>Company</label>
      <input id={`${idPrefix}-company`} name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <input type="hidden" name="consent" value="yes" />
    <label for={`${idPrefix}-email`} class="sr-only">Email address</label>
    <div class="flex flex-col sm:flex-row gap-2">
      <input
        id={`${idPrefix}-email`}
        name="email"
        type="email"
        required
        autocomplete="email"
        placeholder="Email address"
        class="min-w-0 flex-1 rounded-lg border-concrete-300 focus:border-skate-orange focus:ring-skate-orange"
      />
      <button type="submit" class="min-h-11 px-4 py-2 rounded-lg bg-skate-orange text-white font-bold border-0 cursor-pointer disabled:opacity-60">
        Send me the roundup
      </button>
    </div>
    <p class="text-xs text-concrete-500">
      By subscribing, you agree to receive the weekly Concrete Comeback email. Unsubscribe anytime.
      <a href="/privacy" class="underline min-h-0 min-w-0">Privacy</a>
    </p>
  </form>
  <p data-newsletter-status role="status" aria-live="polite" class:list={['text-sm font-medium text-concrete-700', compact ? 'mt-2' : 'mt-3']}></p>
</aside>

<script>
  import { initInlineNewsletterSignup } from '../../scripts/newsletter-signup.js';
  document.querySelectorAll<HTMLElement>('.newsletter-inline').forEach(initInlineNewsletterSignup);
</script>
