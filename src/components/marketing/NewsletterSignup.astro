<aside
  id="newsletter-signup"
  hidden
  data-visible="false"
  role="dialog"
  aria-modal="false"
  aria-labelledby="newsletter-title"
  class="fixed z-50 bottom-0 left-0 right-0 sm:left-auto sm:right-5 sm:bottom-5 sm:max-w-md bg-white border border-concrete-200 sm:rounded-xl shadow-2xl p-5 sm:p-6 transition duration-200 translate-y-full opacity-0 data-[visible=true]:translate-y-0 data-[visible=true]:opacity-100"
>
  <button
    type="button"
    data-newsletter-close
    aria-label="Dismiss newsletter signup"
    class="absolute top-2 right-2 w-11 h-11 text-concrete-500 hover:text-concrete-900 bg-transparent border-0 cursor-pointer text-2xl"
  >×</button>
  <p class="text-xs font-bold uppercase tracking-widest text-skate-orange mb-2">Monthly roundup</p>
  <h2 id="newsletter-title" class="font-display text-2xl text-concrete-900 pr-8 mb-2">Keep your comeback rolling</h2>
  <p class="text-sm text-concrete-600 mb-4">
    Get new skate spots and groups, one practical guide, and one community story each month.
  </p>
  <form action="/api/forms/newsletter" method="post" class="space-y-3">
    <div class="sr-only" aria-hidden="true">
      <label for="newsletter-company">Company</label>
      <input id="newsletter-company" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <input type="hidden" name="consent" value="yes" />
    <label for="newsletter-email" class="sr-only">Email address</label>
    <div class="flex flex-col sm:flex-row gap-2">
      <input
        id="newsletter-email"
        name="email"
        type="email"
        required
        autocomplete="email"
        placeholder="Email address"
        class="min-w-0 flex-1 rounded-lg border-concrete-300 focus:border-skate-orange focus:ring-skate-orange"
      />
      <button type="submit" class="min-h-11 px-4 py-2 rounded-lg bg-skate-orange text-white font-bold border-0 cursor-pointer disabled:opacity-60">
        Send me the roundup
      </button>
    </div>
    <p class="text-xs text-concrete-500">
      By subscribing, you agree to receive the monthly Concrete Comeback email. Unsubscribe anytime.
      <a href="/privacy" class="underline">Privacy</a>
    </p>
  </form>
  <p data-newsletter-status role="status" aria-live="polite" class="text-sm font-medium text-concrete-700 mt-3"></p>
</aside>

<script>
  import { initNewsletterSignup } from '../../scripts/newsletter-signup.js';
  const blockedPaths = ['/submit', '/newsletter', '/privacy'];
  if (!blockedPaths.some((path) => window.location.pathname.startsWith(path))) {
    document.querySelectorAll<HTMLElement>('#newsletter-signup').forEach(initNewsletterSignup);
  }
</script>
