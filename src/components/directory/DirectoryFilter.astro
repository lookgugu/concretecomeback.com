---
type FilterType = 'parks' | 'shops' | 'groups';

interface Props {
  type: FilterType;
}

const { type } = Astro.props;
---
<div class="bg-white border border-concrete-200 rounded-xl p-5 sticky top-20">
  <h2 class="font-display text-base text-concrete-800 mb-4 uppercase tracking-wide">Filter</h2>

  <form id="directory-filter" class="flex flex-col gap-5">
    <!-- Near me -->
    <div>
      <button
        type="button"
        id="filter-locate"
        aria-pressed="false"
        class="w-full flex items-center justify-center gap-2 px-3 py-2 text-sm font-medium text-concrete-700 bg-concrete-50 border border-concrete-200 rounded-lg hover:border-skate-orange hover:text-skate-orange transition-colors cursor-pointer disabled:opacity-60 disabled:cursor-wait"
      >
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0a5.5 5.5 0 0 0-5.5 5.5c0 4.1 5.5 10.5 5.5 10.5s5.5-6.4 5.5-10.5A5.5 5.5 0 0 0 8 0Zm0 7.75A2.25 2.25 0 1 1 8 3.25a2.25 2.25 0 0 1 0 4.5Z"/>
        </svg>
        <span id="filter-locate-label">Find near me</span>
      </button>
      <p
        id="filter-location-status"
        class="text-xs text-concrete-500 mt-1.5 leading-snug"
        role="status"
        aria-live="polite"
        hidden
      ></p>
    </div>

    <!-- Search -->
    <div>
      <label for="filter-search" class="block text-xs text-concrete-500 uppercase tracking-wide mb-1">Search</label>
      <input
        type="search"
        id="filter-search"
        name="q"
        placeholder={type === 'parks' ? 'City or park name…' : type === 'shops' ? 'City or shop name…' : 'City or group name…'}
        class="w-full px-3 py-2 text-sm border border-concrete-200 rounded-lg focus:border-skate-orange focus:outline-none"
      />
    </div>

    <!-- Country -->
    <div>
      <label for="filter-country" class="block text-xs text-concrete-500 uppercase tracking-wide mb-1">Country</label>
      <select
        id="filter-country"
        name="country"
        class="w-full px-3 py-2 text-sm border border-concrete-200 rounded-lg focus:border-skate-orange focus:outline-none bg-white"
      >
        <option value="">All countries</option>
        <option value="US">🇺🇸 United States</option>
        <option value="UK">🇬🇧 United Kingdom</option>
        <option value="CA">🇨🇦 Canada</option>
        <option value="AU">🇦🇺 Australia</option>
      </select>
    </div>

    {type === 'parks' && (
      <>
        <div>
          <span class="block text-xs text-concrete-500 uppercase tracking-wide mb-2">Difficulty</span>
          <div class="flex flex-col gap-1.5">
            {['beginner-friendly', 'mixed', 'intermediate', 'advanced'].map((d) => (
              <label class="flex items-center gap-2 text-sm text-concrete-600 cursor-pointer">
                <input type="radio" name="difficulty" value={d} class="accent-skate-orange" />
                <span class="capitalize">{d.replace(/-/g, ' ')}</span>
              </label>
            ))}
            <label class="flex items-center gap-2 text-sm text-concrete-600 cursor-pointer">
              <input type="radio" name="difficulty" value="" class="accent-skate-orange" checked />
              <span>Any difficulty</span>
            </label>
          </div>
        </div>

        <div>
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" name="adult" value="1" class="accent-skate-orange w-4 h-4" />
            <span class="text-sm text-concrete-700 font-medium">Welcoming to older skaters only</span>
          </label>
        </div>

        <div>
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" name="indoor" value="1" class="accent-skate-orange w-4 h-4" />
            <span class="text-sm text-concrete-700">Indoor parks only</span>
          </label>
        </div>
      </>
    )}

    {type === 'shops' && (
      <>
        <div>
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" name="adult-advice" value="1" class="accent-skate-orange w-4 h-4" />
            <span class="text-sm text-concrete-700 font-medium">Older-skater advice service</span>
          </label>
        </div>
        <div>
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" name="online" value="1" class="accent-skate-orange w-4 h-4" />
            <span class="text-sm text-concrete-700">Has online shop</span>
          </label>
        </div>
      </>
    )}

    {type === 'groups' && (
      <>
        <div>
          <span class="block text-xs text-concrete-500 uppercase tracking-wide mb-2">Format</span>
          <div class="flex flex-col gap-1.5">
            <label class="flex items-center gap-2 text-sm text-concrete-600 cursor-pointer">
              <input type="radio" name="format" value="" class="accent-skate-orange" checked />
              <span>All groups</span>
            </label>
            <label class="flex items-center gap-2 text-sm text-concrete-600 cursor-pointer">
              <input type="radio" name="format" value="in-person" class="accent-skate-orange" />
              <span>In-person only</span>
            </label>
            <label class="flex items-center gap-2 text-sm text-concrete-600 cursor-pointer">
              <input type="radio" name="format" value="online" class="accent-skate-orange" />
              <span>Online only</span>
            </label>
          </div>
        </div>
      </>
    )}

    <button
      type="reset"
      class="text-xs text-concrete-400 hover:text-concrete-700 text-left transition-colors mt-1 bg-transparent border-0 cursor-pointer p-0 min-h-0 min-w-0"
    >
      Clear filters
    </button>
  </form>
</div>

<script>
  import { haversineKm, distanceUnit, formatDistance } from '../../scripts/geo-distance.js';

  // The visitor's position is deliberately kept out of the URL: filter state is
  // meant to be bookmarked and shared, and a shared link should not carry
  // someone's coordinates. sessionStorage instead, so the sort survives moving
  // between /directory/parks, /shops and /groups without a second permission
  // prompt, and is gone when the tab closes.
  const ORIGIN_KEY = 'cc-near-me';

  interface Origin { lat: number; lng: number; }

  function readOrigin(): Origin | null {
    try {
      const raw = sessionStorage.getItem(ORIGIN_KEY);
      if (!raw) return null;
      const parsed = JSON.parse(raw) as Partial<Origin>;
      if (!Number.isFinite(parsed.lat) || !Number.isFinite(parsed.lng)) return null;
      return { lat: parsed.lat as number, lng: parsed.lng as number };
    } catch {
      // Private browsing, blocked site data, or a corrupt value: fall back to
      // an unsorted list rather than breaking the whole filter script.
      return null;
    }
  }

  function writeOrigin(origin: Origin | null): void {
    try {
      if (origin) sessionStorage.setItem(ORIGIN_KEY, JSON.stringify(origin));
      else sessionStorage.removeItem(ORIGIN_KEY);
    } catch { /* not worth failing the sort over */ }
  }

  function setStatus(message: string): void {
    const status = document.getElementById('filter-location-status');
    if (!status) return;
    // Reveal before writing: a mutation inside a display:none live region is
    // outside the accessibility tree and screen readers ignore it.
    status.hidden = !message;
    status.textContent = message;
  }

  function setLocateLabel(text: string): void {
    const label = document.getElementById('filter-locate-label');
    if (label) label.textContent = text;
  }

  const SORTED_STATUS =
    'Nearest first. Distances are approximate — measured to the centre of each town or city. Click again to undo.';

  function showSorted(button: HTMLButtonElement | null): void {
    setLocateLabel('Sorted by distance');
    setStatus(SORTED_STATUS);
    button?.setAttribute('aria-pressed', 'true');
  }

  function showUnsorted(button: HTMLButtonElement | null): void {
    setLocateLabel('Find near me');
    setStatus('');
    button?.setAttribute('aria-pressed', 'false');
  }

  // Bumped by every request and by reset. A geolocation answer that arrives
  // after the visitor has already cleared the filters carries a stale token
  // and is dropped instead of silently undoing the reset and re-persisting a
  // position for the rest of the session.
  let locateGeneration = 0;

  // The sort that is currently applied. This — not sessionStorage — is what
  // the toggle consults: storage exists only to carry the position to the next
  // directory page, and it can be blocked (private browsing, cleared site
  // data), in which case the sort must still be undoable on this page.
  let activeOrigin: Origin | null = null;

  // The server-rendered card order, captured before the first reorder so the
  // sort can be undone exactly.
  let originalOrder: HTMLElement[] | null = null;

  /**
   * Orders the grid nearest-first and stamps each card with its distance.
   *
   * Cards are physically moved in the DOM, not just given a CSS `order`, so
   * keyboard focus order and screen-reader reading order match what the
   * screen shows after the status announces "Nearest first". The served HTML
   * is unaffected either way — this only ever runs after a visitor's click —
   * and `originalOrder` lets clearDistanceSort restore it exactly. Entries
   * with no position (online groups) sort after everything measurable
   * instead of being treated as lat 0, lng 0.
   */
  function sortByDistance(origin: Origin): void {
    const grid = document.getElementById('directory-grid');
    if (!grid) return;
    const unit = distanceUnit(navigator.language);
    const cards = Array.from(grid.querySelectorAll<HTMLElement>(':scope > article'));
    originalOrder ??= cards.slice();
    activeOrigin = origin;

    const ranked = cards.map((card) => {
      const lat = Number(card.dataset.lat);
      const lng = Number(card.dataset.lng);
      const positioned = Number.isFinite(lat) && Number.isFinite(lng)
        && (card.dataset.lat ?? '') !== '' && (card.dataset.lng ?? '') !== '';
      return {
        card,
        km: positioned ? haversineKm(origin, { lat, lng }) : Infinity,
        // A country-precision position is the centre of mass of that country's
        // listings, so it orders a nationwide entry sensibly but must never be
        // reported as a distance anyone could drive.
        measurable: positioned && card.dataset.position !== 'country',
      };
    });

    ranked.sort((a, b) => a.km - b.km);

    // append() re-inserts each card in ranked order in a single pass.
    grid.append(...ranked.map(({ card }) => card));

    ranked.forEach(({ card, km, measurable }) => {
      const badge = card.querySelector<HTMLElement>('[data-distance]');
      if (!badge) return;
      if (measurable && Number.isFinite(km)) {
        badge.textContent = ` · ${formatDistance(km, unit)}`;
        badge.hidden = false;
      } else {
        badge.textContent = '';
        badge.hidden = true;
      }
    });
  }

  /** Undoes sortByDistance, restoring the server-rendered order. */
  function clearDistanceSort(button: HTMLButtonElement | null): void {
    locateGeneration++;
    activeOrigin = null;
    writeOrigin(null);
    const grid = document.getElementById('directory-grid');
    if (grid && originalOrder) grid.append(...originalOrder);
    document.querySelectorAll<HTMLElement>('#directory-grid > article').forEach((card) => {
      const badge = card.querySelector<HTMLElement>('[data-distance]');
      if (badge) {
        badge.textContent = '';
        badge.hidden = true;
      }
    });
    if (button) button.disabled = false;
    showUnsorted(button);
  }

  function geolocationErrorMessage(err: GeolocationPositionError): string {
    switch (err.code) {
      case err.PERMISSION_DENIED:
        return 'Location access was blocked. You can still search by city above.';
      case err.POSITION_UNAVAILABLE:
        return "Couldn't work out where you are. Try searching by city instead.";
      case err.TIMEOUT:
        return 'Finding your location took too long. Try again, or search by city.';
      default:
        return 'Something went wrong finding your location. Try searching by city.';
    }
  }

  function requestLocation(button: HTMLButtonElement): void {
    if (!('geolocation' in navigator)) {
      setStatus('This browser cannot share your location. Search by city instead.');
      return;
    }

    const generation = ++locateGeneration;
    button.disabled = true;
    setLocateLabel('Locating…');
    setStatus('');

    navigator.geolocation.getCurrentPosition(
      (position) => {
        if (generation !== locateGeneration) return;
        const origin = {
          lat: position.coords.latitude,
          lng: position.coords.longitude,
        };
        writeOrigin(origin);
        sortByDistance(origin);
        button.disabled = false;
        showSorted(button);
      },
      (err) => {
        if (generation !== locateGeneration) return;
        button.disabled = false;
        showUnsorted(button);
        setStatus(geolocationErrorMessage(err));
      },
      { enableHighAccuracy: false, timeout: 10000, maximumAge: 600000 },
    );
  }

  function debounce<T extends (...args: unknown[]) => void>(fn: T, ms: number): T {
    let id: ReturnType<typeof setTimeout>;
    return ((...args: unknown[]) => { clearTimeout(id); id = setTimeout(() => fn(...args), ms); }) as T;
  }

  function applyFilters(): void {
    const params = new URLSearchParams(window.location.search);
    const search     = (params.get('q') ?? '').toLowerCase().trim();
    const country    = params.get('country') ?? '';
    const difficulty = params.get('difficulty') ?? '';
    const adultOnly  = params.get('adult') === '1';
    const indoorOnly = params.get('indoor') === '1';
    const adultAdviceOnly = params.get('adult-advice') === '1';
    const onlineShop = params.get('online') === '1';
    const format     = params.get('format') ?? '';

    let visible = 0;

    document.querySelectorAll<HTMLElement>('#directory-grid > article').forEach((card) => {
      let show = true;

      if (country && card.dataset.country !== country) show = false;

      if (difficulty && card.dataset.difficulty !== difficulty) show = false;

      if (adultOnly && card.dataset.adult !== 'true') show = false;

      if (indoorOnly && card.dataset.indoor !== 'true') show = false;

      if (adultAdviceOnly && card.dataset.adultAdvice !== 'true') show = false;

      if (onlineShop && card.dataset.online !== 'true') show = false;

      if (format === 'online'    && card.dataset.online !== 'true')  show = false;
      if (format === 'in-person' && card.dataset.online === 'true')  show = false;

      if (search) {
        const haystack = `${card.dataset.name ?? ''} ${card.dataset.city ?? ''} ${card.dataset.tags ?? ''}`;
        if (!haystack.includes(search)) show = false;
      }

      card.hidden = !show;
      if (show) visible++;
    });

    const counter = document.getElementById('filter-count');
    if (counter) counter.textContent = String(visible);

    const noResults = document.getElementById('no-results');
    if (noResults) noResults.hidden = visible > 0;
  }

  function syncToURL(form: HTMLFormElement): void {
    const data = new FormData(form);
    const params = new URLSearchParams();
    for (const [key, val] of data.entries()) {
      if (val) params.append(key, val as string);
    }
    const qs = params.toString();
    history.replaceState(null, '', qs ? `${window.location.pathname}?${qs}` : window.location.pathname);
    applyFilters();
  }

  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('directory-filter') as HTMLFormElement | null;
    if (!form) return;

    // Restore values from URL on load
    const params = new URLSearchParams(window.location.search);
    params.forEach((value, key) => {
      const els = form.querySelectorAll<HTMLInputElement>(`[name="${key}"]`);
      els.forEach((el) => {
        if (el.type === 'radio' || el.type === 'checkbox') {
          el.checked = el.value === value;
        } else {
          el.value = value;
        }
      });
    });

    applyFilters();

    // The button toggles: while a sort is active, clicking it undoes the sort
    // alone. Otherwise the only way out was "Clear filters", which also wipes
    // every other filter and the session-wide position with it.
    const locate = document.getElementById('filter-locate') as HTMLButtonElement | null;
    if (locate) {
      locate.addEventListener('click', () => {
        if (activeOrigin) clearDistanceSort(locate);
        else requestLocation(locate);
      });
    }

    // A position shared earlier this session re-applies silently: the browser
    // has already been asked, so asking again on every directory page would be
    // noise.
    const stored = readOrigin();
    if (stored) {
      sortByDistance(stored);
      showSorted(locate);
    }

    const debouncedSync = debounce(() => syncToURL(form), 200);
    form.addEventListener('input', debouncedSync);

    form.addEventListener('reset', () => {
      requestAnimationFrame(() => {
        history.replaceState(null, '', window.location.pathname);
        clearDistanceSort(locate);
        applyFilters();
      });
    });
  });
</script>
